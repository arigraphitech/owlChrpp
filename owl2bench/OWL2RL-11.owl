    <owl:Class rdf:about="https://kracr.iiitd.edu.in/OWL2Bench#LeisureStudent">
        <rdfs:subClassOf rdf:resource="https://kracr.iiitd.edu.in/OWL2Bench#Student"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://kracr.iiitd.edu.in/OWL2Bench#Student"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://kracr.iiitd.edu.in/OWL2Bench#takesCourse"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                        <owl:onClass rdf:resource="https://kracr.iiitd.edu.in/OWL2Bench#Course"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


