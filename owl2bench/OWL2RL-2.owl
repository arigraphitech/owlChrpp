        <rdfs:range rdf:resource="http://benchmark/OWL2Bench#EvaluationCommittee"/>
    </owl:ObjectProperty>
    


    <!-- http://benchmark/OWL2Bench#evaluates -->


    <owl:ObjectProperty rdf:about="http://benchmark/OWL2Bench#evaluates">
