    <!-- http://benchmark/OWL2Bench#hasAdvisor -->


    <owl:ObjectProperty rdf:about="http://benchmark/OWL2Bench#hasAdvisor">
        <owl:equivalentProperty rdf:resource="http://benchmark/OWL2Bench#isAdvisedBy"/>
