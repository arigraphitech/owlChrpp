}

LogicalVarSetIterator getBegin(const LogicalVarSet& s){
    return s.begin();
}

LogicalVarSetIterator getEnd(const LogicalVarSet& s){
    return s.end();
}


bool samePrefix(const std::string & px,const std::string & x){
        size_t pos = px.find(':');
        std::string pref = px.substr(0, pos);
        return (pref==x) ;
}

bool prefixIntern(const std::string & uri){
        size_t pos = uri.find('#');
        std::string pref = uri.substr(0, pos);
        return (pref=="http://anonymous.org") ;
}


template <typename T>
bool checkClassification(T& pb,const std::string & x ,const std::string & c){
    auto it = pb.get_owlClassAssertion_store().begin();
    while (!it.at_end())
    {    if((*std::get<1>(*it))==x && (*std::get<2>(*it))==c)
        {
            return true;
        }
         ++it;
    }
    return false;
}


std::string constructFullUri(const std::string& prefix,
                             const std::string& localName)
{
    auto pos = localName.find(':');
    std::string name = localName.substr(pos+1);
    return prefix + ":" + name;
}

bool sameDataType(const std::shared_ptr<AnySimpleType> dr1, const std::shared_ptr<AnySimpleType> dr2){
    if (!dr1 || !dr2) {
        return false;  // Null types are not considered equal
    }
    return dr1->getId() == dr2->getId();
}
bool differentValues(const Value& lhs, const Value& rhs) {
    return !(lhs == rhs);
}
bool invalidType(const std::shared_ptr<AnySimpleType> dr, const Value & v){
    // Check the XSD type hierarchy
    // dr est le type attendu (range), v.typeVal est le type de la valeur
    if (!dr || !v.typeVal) {
        return true;  // A type is invalid if either type is null
    }
    bool isValid = v.typeVal->verify(dr.get());    
    return !isValid;  // Return true when the type is invalid
}

Value createValue(const std::string& val, const std::shared_ptr<AnySimpleType> typeVal) {
    Value v;
    v.val = val;
    v.typeVal = typeVal;
    return v;
}
bool equalIncrement(int j,int i){
    return j==i+1;
}

using Pair = std::pair<LogicalVar, LogicalVar>;

struct PairHash {
    std::size_t operator()(const Pair& pair) const noexcept {
        const auto first = LogicalVarHash{}(pair.first);
        const auto second = LogicalVarHash{}(pair.second);
        return first ^ (second + std::size_t{0x9e3779b9u}
                        + (first << 6) + (first >> 2));
    }
};

struct PairEqual {
    bool operator()(const Pair& lhs, const Pair& rhs) const noexcept {
        return LogicalVarEqual{}(lhs.first, rhs.first)
            && LogicalVarEqual{}(lhs.second, rhs.second);
    }
};

using SetPair = std::unordered_set<Pair, PairHash, PairEqual>;

// CHR++ also needs instructions for displaying/comparing the mutable set.
namespace chr {
template <>
struct XXHash<SetPair> {
    static void update(const SetPair& pairs) {
        std::size_t hash = 0;
        for (const auto& pair : pairs) {
            hash += PairHash{}(pair);
        }
        // Set iteration order must not affect its hash.
        XXHash<std::size_t>::update(pairs.size());
        XXHash<std::size_t>::update(hash);
    }
};

template <>
struct Type_instruction_wrapper<SetPair, false> {
    static std::string to_string(const SetPair& pairs) {
        return "SetPair(size=" + std::to_string(pairs.size()) + ")";
    }
    static void update_hash(const SetPair& pairs) {
        XXHash<SetPair>::update(pairs);
    }
    static bool is_equal(const SetPair& lhs, const SetPair& rhs) {
        if (lhs.size() != rhs.size()) return false;
        for (const auto& pair : lhs) {
            if (rhs.find(pair) == rhs.end()) return false;
        }
        return true;
    }
};
}

SetPair makeSetPair(const LogicalVar& x, const LogicalVar& y) {
    return SetPair{Pair{x, y}};
}

chr::ES_CHR stock_pair(chr::Logical_var_mutable<SetPair>& stock,
                       const LogicalVar& x, const LogicalVar& y) {
    // No rule depends on the set contents: avoid waking stock during collection.
    return stock.update_mutable(false, [&](SetPair& pairs) {
        pairs.emplace(x, y);
    });
}

std::vector<Pair> extend_transitive_pairs(SetPair& pairs) {
    using Adjacency = std::unordered_map<LogicalVar, std::vector<LogicalVar>,
                                         LogicalVarHash, LogicalVarEqual>;
    Adjacency successors;
    for (const auto& pair : pairs) {
        successors[pair.first].push_back(pair.second);
    }

    std::vector<Pair> additions;
    // Traverse a fixed adjacency index, not iterators of the growing pair set.
    for (const auto& entry : successors) {
        const auto& source = entry.first;
        std::unordered_set<LogicalVar, LogicalVarHash, LogicalVarEqual> visited;
        std::vector<LogicalVar> pending;
        for (const auto& target : entry.second) {
            if (visited.insert(target).second) pending.push_back(target);
        }
        for (std::size_t i = 0; i < pending.size(); ++i) {
            // Copy before push_back can reallocate pending.
            const LogicalVar target = pending[i];
            if (pairs.emplace(source, target).second) {
                additions.emplace_back(source, target);
            }
            const auto next = successors.find(target);
            if (next == successors.end()) continue;
            for (const auto& neighbour : next->second) {
                if (visited.insert(neighbour).second) pending.push_back(neighbour);
            }
        }
    }
    // Starting from neighbours includes self pairs only when a cycle exists.
    return additions;
}

template <typename Space>
chr::ES_CHR post_trans_closure(Space& space, const LogicalVar& property,
                              chr::Logical_var_mutable<SetPair>& stock,
                              bool& posted) {
    std::vector<Pair> additions;
    const auto status = stock.update_mutable(false, [&](SetPair& pairs) {
        additions = extend_transitive_pairs(pairs);
    });
    if (status == chr::ES_CHR::FAILURE) return status;

    // Each new pair was inserted in the set before posting it exactly once.
    // Direct CHR transitivity is disabled, so these calls do not recurse into it.
    for (const auto& pair : additions) {
        if (space.owlObjectPropertyAssertion(pair.first, property, pair.second)
            == chr::ES_CHR::FAILURE) return chr::ES_CHR::FAILURE;
        posted = true;
    }
    return chr::ES_CHR::SUCCESS;
}

template <typename Space>
chr::ES_CHR post_all_trans_closures(Space& space) {
    using Stock = std::pair<LogicalVar, chr::Logical_var_mutable<SetPair>>;
    std::unordered_map<LogicalVar, std::size_t, LogicalVarHash, LogicalVarEqual>
        closedSizes;

    for (;;) {
        // Other rules may have added edges for any transitive property since
        // the last round. Collection finishes before any closure is posted.
        if (space.collect_transitive_pairs() == chr::ES_CHR::FAILURE)
            return chr::ES_CHR::FAILURE;

        std::vector<Stock> stocks;
        auto it = space.get_stock_store().begin();
        while (!it.at_end()) {
            stocks.emplace_back(std::get<1>(*it), std::get<2>(*it));
            ++it;
        }

        bool posted = false;
        for (auto& stock : stocks) {
            const auto previous = closedSizes.find(stock.first);
            if (previous != closedSizes.end()
                && previous->second == (*stock.second).size()) continue;
            if (post_trans_closure(space, stock.first, stock.second, posted)
                == chr::ES_CHR::FAILURE) return chr::ES_CHR::FAILURE;
            closedSizes[stock.first] = (*stock.second).size();
        }
        // No new closure assertion means all other rules are also saturated.
        if (!posted) return chr::ES_CHR::SUCCESS;
    }
}
